  "e58c380eee1e9ab8": {
   "s": "Vena Arcanum Wake",
   "loc": [
    "src/cult/events/upgrade/VenaArcanumWake.hx:19"
   ],
   "where": "VenaArcanumWake.create",
   "field": "title",
   "kind": "T",
   "t": "Veillée de Vena Arcanum",
   "status": "done",
   "passes": [
    {
     "pass": 1,
     "t": "Veillée de Vena Arcanum"
    },
    {
     "pass": 2,
     "t": null
    }
   ],
   "doubt": "\"Wake\" is read as a vigil (« Veillée »), which fits the kneeling scene in 2. If the event is meant as an awakening of Vena Arcanum, use « Réveil de Vena Arcanum »."
  },
  "a453607a9eab7660": {
   "s": "Sealed railyard infirmary glows with emergency lanterns as the newly ranked striker kneels beside a chilled Vena Arcanum cistern. Masked confessors murmur prayers through respirator hoods while trauma techs stitch synth sinew under blackout tarps. Only the inner circle watches the monitors flicker.",
   "loc": [
    "src/cult/events/upgrade/VenaArcanumWake.hx:20"
   ],
   "where": "VenaArcanumWake.create",
   "field": "text",
   "kind": "T",
   "t": "L’infirmerie scellée de la gare de triage luit sous les lanternes de secours tandis que l’assaillant fraîchement promu s’agenouille près d’une citerne réfrigérée de Vena Arcanum. Des confesseurs masqués murmurent des prières à travers leurs cagoules respiratoires pendant que des techniciens en traumatologie suturent des tendons synthétiques sous des bâches occultantes. Seul le premier cercle regarde les moniteurs vaciller.",
   "status": "done",
   "passes": [
    {
     "pass": 1,
     "t": "L’infirmerie scellée de la gare de triage luit sous les lanternes de secours tandis que l’assaillant fraîchement promu s’agenouille près d’une citerne réfrigérée de Vena Arcanum. Des confesseurs masqués murmurent des prières à travers leurs cagoules respiratoires pendant que des techniciens en traumatologie suturent des tendons synthétiques sous des bâches occultantes. Seul le premier cercle regarde les moniteurs vaciller."
    },
    {
     "pass": 2,
     "t": null
    }
   ]
  },
