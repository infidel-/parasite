  var SCENARIO_ALIEN_MISSION_ABDUCTION_GO_SPACESHIP = 'SCENARIO_ALIEN_MISSION_ABDUCTION_GO_SPACESHIP';
  var SCENARIO_ALIEN_MISSION_FAILURE_GO_SPACESHIP = 'SCENARIO_ALIEN_MISSION_FAILURE_GO_SPACESHIP';
  var SCENARIO_ALIEN_MISSION_INFILTRATION = 'SCENARIO_ALIEN_MISSION_INFILTRATION';
  var SCENARIO_ALIEN_MISSION_RESEARCH = 'SCENARIO_ALIEN_MISSION_RESEARCH';
  var SCENARIO_ALIEN_MISSION_LIQUIDATION = 'SCENARIO_ALIEN_MISSION_LIQUIDATION';
